<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.gringuard">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gringuard"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <activity
            android:name=".WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".Profile"
            android:exported="false"
            android:label="Set Up Profile" />

        <activity
            android:name=".DashBoardActivity"
            android:exported="true" />

        <activity
            android:name=".EditActivity"
            android:exported="false"
            android:label="Edit Profile" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DentistRecommendationActivity"
            android:exported="false" />

        <activity
            android:name=".HelpSupportActivity"
            android:exported="false" />

        <activity
            android:name=".AboutUsActivity"
            android:label="About Us"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".MainActivity_login"
            android:exported="false" />

        <activity
            android:name=".HealthActivity"
            android:exported="false"
            android:label="Health Tracker" />

        <activity
            android:name=".Cavity_Activity"
            android:exported="false" />

        <activity
            android:name=".Gingivitis_Activity"
            android:exported="false" />

        <activity
            android:name=".Fractured_Teeth_Activity"
            android:exported="false" />

        <activity
            android:name=".GingitivitisLowActivity"
            android:exported="false"
            android:label="Gingivitis Tips" />

        <activity
            android:name=".ResultActivity"/>

    </application>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
</manifest>
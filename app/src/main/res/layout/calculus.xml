<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEBEE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculus Severity Assessment"
            android:textColor="#AD1457"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Visible Tartar on Teeth" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgVisual" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q1_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Small yellow deposits near gums"/>
                    <RadioButton android:id="@+id/q1_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noticeable tartar on several teeth"/>
                    <RadioButton android:id="@+id/q1_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heavy tartar covering many teeth"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Gum Irritation" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgColor" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q2_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Healthy pink gums"/>
                    <RadioButton android:id="@+id/q2_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red or slightly inflamed gums"/>
                    <RadioButton android:id="@+id/q2_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red or slightly inflamed gums"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Tooth Surface Roughness" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgSensitivity" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q3_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teeth feel smooth"/>
                    <RadioButton android:id="@+id/q3_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rough spots felt with tongue"/>
                    <RadioButton android:id="@+id/q3_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heavy rough tartar deposits"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4. Gum Bleeding" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgSwelling" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q4_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rarely bleeds"/>
                    <RadioButton android:id="@+id/q4_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bleeds during brushing"/>
                    <RadioButton android:id="@+id/q4_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Frequent Bleeding"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5. Area Affected" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgCoverage" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q5_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Only a few teeth"/>
                    <RadioButton android:id="@+id/q5_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Several areas in mouth"/>
                    <RadioButton android:id="@+id/q5_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Most teeth affected"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6. Bad Breath; Taste" android:textStyle="bold" android:textColor="#880E4F"/>
                <RadioGroup android:id="@+id/rgBreath" android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/q6_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal/Morning breath only"/>
                    <RadioButton android:id="@+id/q6_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bad breath occasionally"/>
                    <RadioButton android:id="@+id/q6_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Constant strong odor"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Check Severity"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp"
            android:background="#FFFFFF"
            android:textColor="#AD1457"
            android:text="Select all options to see results"/>

    </LinearLayout>
</ScrollView>
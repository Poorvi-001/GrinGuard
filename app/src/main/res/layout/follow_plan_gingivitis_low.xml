<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Follow Plan"
            android:textColor="#E91E63"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gingivitis - Low Severity"
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark the activities you completed today"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp">

            <CheckBox
                android:id="@+id/checkHardFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you brush your teeth twice today using a soft toothbrush?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/checkBrush"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you floss gently to remove food particles between teeth?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/checkRinse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you rinse your mouth with an antibacterial mouthwash?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/checkColdFood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you avoid very sugary foods that may worsen gum irritation?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/checkMonitor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you check your gums for redness, swelling, or bleeding today?"
                android:textColor="#000000"
                android:textSize="16sp"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="20dp"/>


            <Button
                android:id="@+id/savePlanBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Progress"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#E91E63"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">


        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Follow Plan"
            android:textColor="#E91E63"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp"/>


        <TextView
            android:id="@+id/diseaseText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caries - Low Severity"
            android:textColor="#E91E63"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>


        <TextView
            android:id="@+id/instructionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark the activities you completed today:"
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:elevation="4dp">


            <CheckBox
                android:id="@+id/checkBrush"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you brush your teeth twice today using fluoride toothpaste?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>


            <CheckBox
                android:id="@+id/checkFloss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you floss your teeth today?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>


            <CheckBox
                android:id="@+id/checkSugar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you avoid sugary snacks and drinks today?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>


            <CheckBox
                android:id="@+id/checkWater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you drink plenty of water today?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="12dp"/>


            <CheckBox
                android:id="@+id/checkMouthwash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Did you use antibacterial mouthwash today?"
                android:textSize="16sp"
                android:textColor="#000000"
                android:buttonTint="#E91E63"
                android:layout_marginBottom="20dp"/>


            <Button
                android:id="@+id/savePlanBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Progress"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#E91E63"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
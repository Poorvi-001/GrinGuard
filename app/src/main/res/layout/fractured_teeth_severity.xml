<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEBEE"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tooth Fracture Assessment"
        android:textColor="#AD1457"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Break Appearance" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgVisual" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q1_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="White (Enamel)"/>
                <RadioButton android:id="@+id/q1_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yellow/Cream (Dentin)"/>
                <RadioButton android:id="@+id/q1_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red dot/Bleeding (Pulp)"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Cold Sensitivity" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgCold" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q2_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None / Quick zing"/>
                <RadioButton android:id="@+id/q2_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sharp (5-10s)"/>
                <RadioButton android:id="@+id/q2_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lingering/Throbbing"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Biting Pain" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgBite" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q3_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No pain"/>
                <RadioButton android:id="@+id/q3_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sharp pain on release"/>
                <RadioButton android:id="@+id/q3_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cannot bite down"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4. Tooth Stability" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgStability" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q4_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feels firm"/>
                <RadioButton android:id="@+id/q4_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feels slightly 'off'"/>
                <RadioButton android:id="@+id/q4_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loose or shifted"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5. Constant Pain" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgSpontaneous" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q5_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None"/>
                <RadioButton android:id="@+id/q5_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Occasional ache"/>
                <RadioButton android:id="@+id/q5_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Severe throbbing"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardCornerRadius="8dp" app:cardBackgroundColor="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6. Gum Condition" android:textStyle="bold" android:textColor="#880E4F"/>
            <RadioGroup android:id="@+id/rgGums" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/q6_low" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal"/>
                <RadioButton android:id="@+id/q6_med" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red/Swollen"/>
                <RadioButton android:id="@+id/q6_high" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bruising/Pimple"/>
            </RadioGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Analyze Severity"
        android:backgroundTint="#E91E63"
        android:textColor="#FFFFFF"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="15dp"
        android:background="#FFFFFF"
        android:textColor="#AD1457"
        android:text="Select all options to see results"/>

</LinearLayout>
</ScrollView>